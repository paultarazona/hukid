{
  "openapi": "3.1.0",
  "info": {
    "title": "HukID verification sessions — VER-T11 contract (draft, list added for VER-T11-e)",
    "version": "0.1.0-draft",
    "description": "Own contract for the per-tenant Verifier-as-a-Service (ADR-0033). Draft: the start operation (VER-T11-c2) and the reads (VER-T11-e) have handlers, mounted in cmd/api only when the verification configuration is set. verification:start and verification:read are declared in capabilities.json (VER-T11-c1) for tenant_admin and security_admin; only the start handler consumes verification:start. Responses never carry the JWS, claims, vp_token, nonce or state (VER-FR08). VER-T11-e adds the read-only list used by the console (ADR-0033 amendment 2026-11-18): newest first, keyset-paginated per tenant, same fields as the single read, no JWS, claims, nonce or state. Implemented (VER-T11-e1, e2) for the Bearer API and for the console cookie mount; the console reads only, starting a session stays a Bearer operation with fresh MFA."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Isolated loopback test profile"
    }
  ],
  "security": [],
  "paths": {
    "/v1/operator/tenants/{tenantId}/verification-sessions": {
      "post": {
        "operationId": "operatorStartVerificationSession",
        "summary": "Start a verification session for the tenant (proposed capability verification:start, fresh MFA required)",
        "security": [
          {
            "operatorBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ttlSeconds": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 900,
                    "description": "Proposed default 300; the module cap is 15 minutes."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created. The launch URI is the only handle; nonce, state and keys are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationSessionCreated"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "get": {
        "operationId": "operatorListVerificationSessions",
        "summary": "List the tenant's verification sessions, newest first (capability verification:read, no step-up)",
        "security": [
          {
            "operatorBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "completed",
                "expired"
              ]
            },
            "description": "Filter. expired is derived from expires_at at read time, as in the single read."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 2048,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "description": "Opaque authenticated cursor over (created_at, session_id) descending, bound to tenant, actor and filter. Invalid, expired or foreign cursors return 422."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of sessions for the authorized tenant only (RLS and membership). Cache-Control: no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationSessionPage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/operator/tenants/{tenantId}/verification-sessions/{sessionId}": {
      "get": {
        "operationId": "operatorGetVerificationSession",
        "summary": "Read the state and result of a session (proposed capability verification:read)",
        "security": [
          {
            "operatorBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Public session identifier, unrelated to the OpenID4VP state."
          }
        ],
        "responses": {
          "200": {
            "description": "Session state; result fields are present only once the session is completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationSession"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/console/api/tenants/{tenantId}/verification-sessions": {
      "post": {
        "operationId": "consoleStartVerificationSession",
        "summary": "Start a verification session from the console (ADR-0037, proposed): active tenant, exact console Origin, CSRF proof, verification:start and fresh MFA",
        "security": [
          {
            "consoleSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 2048
            },
            "description": "Must equal the configured console origin."
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ttlSeconds": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 900,
                    "description": "Proposed default 300; the module cap is 15 minutes."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created. The launch URI is the only handle; nonce, state and keys are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationSessionCreated"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "get": {
        "operationId": "consoleListVerificationSessions",
        "summary": "List the tenant's verification sessions, newest first (capability verification:read, no step-up) — browser mount: requires the explicitly selected active tenant, otherwise 404",
        "security": [
          {
            "consoleSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "completed",
                "expired"
              ]
            },
            "description": "Filter. expired is derived from expires_at at read time, as in the single read."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 2048,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "description": "Opaque authenticated cursor over (created_at, session_id) descending, bound to tenant, actor and filter. Invalid, expired or foreign cursors return 422."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of sessions for the authorized tenant only (RLS and membership). Cache-Control: no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationSessionPage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/console/api/tenants/{tenantId}/verification-sessions/{sessionId}": {
      "get": {
        "operationId": "consoleGetVerificationSession",
        "summary": "Read the state and result of a session (proposed capability verification:read) — browser mount: requires the explicitly selected active tenant, otherwise 404",
        "security": [
          {
            "consoleSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Public session identifier, unrelated to the OpenID4VP state."
          }
        ],
        "responses": {
          "200": {
            "description": "Session state; result fields are present only once the session is completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationSession"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "operatorBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Operator token. Capabilities come from the local membership, never from token roles."
      },
      "consoleSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "hukid_test_session",
        "description": "Console session cookie (AUTH test profile). Browser reads only; no bearer tokens in the browser."
      }
    },
    "parameters": {
      "TenantId": {
        "name": "tenantId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Resource selector; the server validates active tenant membership."
      }
    },
    "responses": {
      "Error": {
        "description": "Generic error without remote or internal detail.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "VerificationSessionCreated": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "launchUri",
          "expiresAt"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "launchUri": {
            "type": "string",
            "description": "openid4vp launch URI for the wallet."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "VerificationSession": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "status",
          "createdAt",
          "expiresAt"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "completed",
              "expired"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ],
            "description": "Only when status is completed."
          },
          "codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Failure codes from the closed set (CodesVersion 2). Only when status is completed."
          },
          "reportDigest": {
            "type": "string",
            "description": "Digest of the report; never the JWS or claims. Only when status is completed.",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "VerificationSessionPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/VerificationSession"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null on the last page."
          }
        }
      }
    }
  }
}
